# ══════════════════════════════════════════════════════════════
# Netline Reader Frontend — Environment Variables
# ══════════════════════════════════════════════════════════════
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Vite embeds VITE_* variables at build time.
# All values below are the defaults already coded in auth.js,
# so .env.local is optional unless you need to override them.
#
# ── Keycloak connection (browser-accessible URL) ──
#   Must be the URL the *browser* uses to reach Keycloak.
#   In Docker the browser still hits http://localhost:9090.
# ══════════════════════════════════════════════════════════════

# Keycloak server URL (no trailing slash)
VITE_KEYCLOAK_URL=http://localhost:9090

# Keycloak realm name (must match keycloak/netline-realm.json → "realm")
VITE_KEYCLOAK_REALM=netline-reader

# Keycloak client ID for the SPA (public client, PKCE enabled)
VITE_KEYCLOAK_CLIENT=netline-frontend
