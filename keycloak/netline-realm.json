{
  "realm":               "netline-reader",
  "enabled":             true,
  "sslRequired":         "none",
  "registrationAllowed": false,

  "roles": {
    "realm": [
      {
        "name":        "admin",
        "description": "Full admin access — user management, all pages"
      },
      {
        "name":        "staff_ops",
        "description": "Operational staff — Gantt, Schedule, Reports"
      },
      {
        "name":        "chef_escale",
        "description": "Station manager — Schedule and Reports (station-scoped)"
      },
      {
        "name":        "aol_agent",
        "description": "AOL agent — Gantt and Schedule (limited operational view)"
      }
    ]
  },

  "clients": [
    {
      "clientId":              "netline-frontend",
      "name":                  "Netline Reader Frontend (SPA)",
      "description":           "Public OIDC client — React SPA with Authorization Code + PKCE flow.",
      "enabled":               true,

      "publicClient":              true,
      "standardFlowEnabled":       true,
      "implicitFlowEnabled":       false,
      "directAccessGrantsEnabled": false,

      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],

      "protocol":         "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId":    "netline-backend",
      "name":        "Netline Reader Backend (Resource Server)",
      "description": "Bearer-only client — Spring Boot validates JWTs issued for this realm.",
      "enabled":     true,
      "bearerOnly":  true,
      "protocol":    "openid-connect"
    }
  ],

  "users": [
    {
      "username":  "admin",
      "enabled":   true,
      "email":     "admin@ram.ma",
      "firstName": "Admin",
      "lastName":  "System",
      "credentials": [
        { "type": "password", "value": "admin123", "temporary": false }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username":  "ops",
      "enabled":   true,
      "email":     "ops@ram.ma",
      "firstName": "Staff",
      "lastName":  "Ops",
      "credentials": [
        { "type": "password", "value": "ops123", "temporary": false }
      ],
      "realmRoles": ["staff_ops"]
    },
    {
      "username":  "chef",
      "enabled":   true,
      "email":     "chef@ram.ma",
      "firstName": "Chef",
      "lastName":  "Escale",
      "credentials": [
        { "type": "password", "value": "chef123", "temporary": false }
      ],
      "realmRoles": ["chef_escale"]
    },
    {
      "username":  "aol",
      "enabled":   true,
      "email":     "aol@ram.ma",
      "firstName": "Agent",
      "lastName":  "AOL",
      "credentials": [
        { "type": "password", "value": "aol123", "temporary": false }
      ],
      "realmRoles": ["aol_agent"]
    }
  ]
}
